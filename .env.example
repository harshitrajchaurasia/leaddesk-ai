# grok | claude. Empty = claude when ANTHROPIC_API_KEY is set, else grok
LLM_PROVIDER=grok
# optional per-step override, e.g. Grok triage + Claude drafts
TRIAGE_PROVIDER=
DRAFT_PROVIDER=
XAI_API_KEY=
# current model ids: GET https://api.x.ai/v1/language-models
XAI_MODEL=grok-4.20-0309-non-reasoning
# optional: any OpenAI-compatible endpoint instead of api.x.ai (key + model then come from that provider)
XAI_BASE_URL=
# optional: Claude path (model comparison, eval column)
ANTHROPIC_API_KEY=
# only for keys not scoped to a workspace (wrkspc_...)
ANTHROPIC_WORKSPACE_ID=
CLAUDE_TRIAGE_MODEL=claude-haiku-5-5
CLAUDE_DRAFT_MODEL=claude-sonnet-5-5
# optional: without these, Monday items go to data/outbox.jsonl
MONDAY_API_TOKEN=
MONDAY_BOARD_ID=
# optional: in-app login for a hosted demo (empty = no login)
DEMO_USER=
DEMO_PASS=
