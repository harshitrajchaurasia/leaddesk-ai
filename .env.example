# grok | claude. Empty = claude when ANTHROPIC_API_KEY is set, else grok
LLM_PROVIDER=grok
# optional per-step override, e.g. Grok triage + Claude drafts
TRIAGE_PROVIDER=
DRAFT_PROVIDER=
XAI_API_KEY=
# current model ids: GET https://api.x.ai/v1/language-models
XAI_MODEL=grok-4.20-0309-non-reasoning
# optional: any OpenAI-compatible endpoint instead of api.x.ai (key + model then come from that provider)
XAI_BASE_URL=
# optional: Claude path (model comparison, eval column)
ANTHROPIC_API_KEY=
# only for keys not scoped to a workspace (wrkspc_...)
ANTHROPIC_WORKSPACE_ID=
CLAUDE_TRIAGE_MODEL=claude-haiku-5-5
CLAUDE_DRAFT_MODEL=claude-sonnet-5-5
# optional: without these, Monday items go to data/outbox.jsonl
MONDAY_API_TOKEN=
MONDAY_BOARD_ID=
# optional: in-app login for a hosted demo (empty = no login)
DEMO_USER=
DEMO_PASS=

# Go High Level (optional; off unless both are set). Private Integration token with scopes
# contacts.readonly, contacts.write, conversations/message.write.
GHL_API_KEY=
GHL_LOCATION_ID=
# API version header; the docs list v3 as current (older: 2021-07-28)
GHL_API_VERSION=v3
# Contact custom field that holds our client id (e.g. C-01), so an inbound message maps to a client
GHL_CLIENT_FIELD_ID=

# Call analysis (Calls tab). Grok and Claude tie on the call eval (32/32); Grok is faster and cheaper
CALL_PROVIDER=grok
# Monday board for call notes (an item per call, a subitem per action item)
MONDAY_CALLS_BOARD_ID=
